    "@types/react-dom": "^19.2.3",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.122.0"
  }
}
