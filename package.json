{
  "name": "zhijin-navigation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "lint": "oxlint app components lib worker next.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "preview": "npx serve out",
    "cf:types": "wrangler types",
    "deploy:check": "npm run build && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --dry-run",
    "deploy": "npm run build && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --keep-vars"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "next": "^16.1.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@cloudflare/workers-types": "^5.20260813.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.2",
    "wrangler": "^4.122.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
